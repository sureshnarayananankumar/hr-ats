# ============================================================
# HR-ATS  --  Example environment file
# Copy to .env and replace every CHANGE_ME value.
# NEVER commit the real .env file.  Generate secrets with:
#   powershell -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))"
# ============================================================

# ---------- Deployment ----------
NODE_ENV=development
COMPOSE_PROJECT_NAME=hr-ats

# ---------- MySQL (container) ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=hr_ats_db
# Least-privilege application account used by the running API
MYSQL_APP_USER=hr_ats_app
MYSQL_APP_PASSWORD=CHANGE_ME_app_password
# Separate account used ONLY for Prisma migrations (DDL rights)
MYSQL_MIGRATE_USER=hr_ats_migrate
MYSQL_MIGRATE_PASSWORD=CHANGE_ME_migrate_password
# Host port exposed to MySQL Workbench. Bound to 127.0.0.1 only.
MYSQL_HOST_PORT=3307

# ---------- Prisma / Backend DB connection ----------
# Inside Docker the host is the compose service name "mysql" (NOT localhost).
DATABASE_URL="mysql://hr_ats_app:CHANGE_ME_app_password@mysql:3306/hr_ats_db"
# Elevated URL used only by `prisma migrate deploy` in the migration step.
MIGRATE_DATABASE_URL="mysql://hr_ats_migrate:CHANGE_ME_migrate_password@mysql:3306/hr_ats_db"
# When running the backend on the Windows host instead of in Docker, use:
# DATABASE_URL="mysql://hr_ats_app:CHANGE_ME_app_password@127.0.0.1:3307/hr_ats_db"

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- Backend ----------
BACKEND_PORT=3000
API_PREFIX=api
# 64+ random chars. Rotating this invalidates all sessions.
SESSION_SECRET=CHANGE_ME_session_secret_min_64_chars
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_64_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_64_chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
CSRF_SECRET=CHANGE_ME_csrf_secret_min_32_chars
# Cookie flags. COOKIE_SECURE must be true in production (HTTPS only).
# COOKIE_DOMAIN: leave EMPTY for a host-only cookie (recommended).
# Set it only when the API and SPA sit on different subdomains.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Comma separated. No wildcards when credentials are used.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080
# Trust the Kong gateway hop only (prevents X-Forwarded-For spoofing)
TRUST_PROXY_HOPS=1
# Shared secret Kong injects; backend rejects direct public traffic in prod
GATEWAY_SHARED_SECRET=CHANGE_ME_gateway_shared_secret

# ---------- File storage (private, outside web root) ----------
STORAGE_ROOT=/app/storage
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_MIME=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ---------- Mail (SMTP) ----------
# Dev uses MailHog in docker-compose; no credentials required.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="HR ATS <no-reply@hr-ats.local>"

# ---------- Frontend ----------
FRONTEND_PORT=5173
# The browser talks to Kong, never to the backend directly.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME="HR ATS"

# ---------- Kong Gateway ----------
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
# Admin API is NOT published to the host by default. See docs/KONG_SECURITY.md.
KONG_ADMIN_PORT=8001

# ---------- Seeding (development only) ----------
# Used by `npm run seed`. Never set these in production.
SEED_ADMIN_EMAIL=superadmin@hr-ats.local
SEED_DEFAULT_PASSWORD=CHANGE_ME_dev_only_password
